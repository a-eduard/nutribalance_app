rules_version = '2';

// ============================================================================
// Моя Ева — правила Firestore. ЭТАП 2 (строгие)
//
// Включайте, когда почти все пользователи обновятся до новой версии приложения
// (старые версии читают чужие профили напрямую и сами меняют isPro/лимиты).
//  • Документ users/{uid} (здоровье, вес, цикл, анкета) читает ТОЛЬКО владелец.
//    Для поиска и списка чатов используется public_profiles (имя, ник, фото).
//  • Клиент не может выдать себе Premium, продлить срок или сбросить лимиты —
//    это делают только Cloud Functions (verifyRuStorePurchase, redeemPromo, askDietitian).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function inChatId(chatId) { return signedIn() && chatId.split('_').hasAny([request.auth.uid]); }

    function privilegedKeys() {
      return ['isPro', 'proUntil', 'hasSpecialistAccess', 'specialistUntil', 'usedPromoCodes',
              'free_messages_left', 'free_scans_left'];
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['proUntil', 'hasSpecialistAccess', 'specialistUntil', 'usedPromoCodes'])
        && request.resource.data.get('isPro', false) == false;
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedKeys());
      allow delete: if isOwner(uid);

      // insights пишет только сервер (weeklyInsights)
      match /insights/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /{col}/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && col != 'insights';
      }
    }

    match /public_profiles/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.users || inChatId(chatId));
      allow create, update: if inChatId(chatId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if inChatId(chatId);
        allow create: if inChatId(chatId) && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.get('text', '').size() <= 4000;
        allow update: if inChatId(chatId) && resource.data.senderId == request.auth.uid
                      && request.resource.data.senderId == resource.data.senderId;
        allow delete: if inChatId(chatId) && resource.data.senderId == request.auth.uid;
      }
    }

    match /app_settings/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /app_config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /purchases/{id} { allow read, write: if false; }
    match /promocodes/{id} { allow read, write: if false; }
  }
}
