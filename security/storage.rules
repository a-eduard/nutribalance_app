rules_version = '2';

// Моя Ева — правила Firebase Storage.
// Ссылки getDownloadURL() (аватарки, фото еды, фото в чатах) продолжают работать
// для всех, у кого есть ссылка, — правила ограничивают только загрузку и листинг.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function smallImageOrPdf(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'application/octet-stream');
    }

    // Личные файлы: аватар, фото еды, вложения для Евы (users/{uid}/ai_chat/...)
    match /users/{uid}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && smallImageOrPdf(15);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Фото в чатах между пользователями
    match /chats_media/{chatId}/{file} {
      allow read, delete: if signedIn() && chatId.split('_').hasAny([request.auth.uid]);
      allow create: if signedIn() && chatId.split('_').hasAny([request.auth.uid]) && smallImageOrPdf(10);
    }

    // Фото еды из старых версий приложения (до апреля 2026): meals/{uid}/fast_scan_*.jpg
    match /meals/{uid}/{file} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && smallImageOrPdf(15);
    }

    // Старый путь фото в чатах (старые версии): chats/{chatId}/{время}_{uid}.jpg.
    // Загружать можно только файл со своим uid в имени; читать и удалять —
    // участникам чата или автору файла. Ссылки getDownloadURL работают как раньше.
    match /chats/{chatId}/{file} {
      allow read, delete: if signedIn()
        && (chatId.split('_').hasAny([request.auth.uid]) || file.matches('.*_' + request.auth.uid + '[.]jpg'));
      allow create, update: if signedIn() && file.matches('.*_' + request.auth.uid + '[.]jpg') && smallImageOrPdf(10);
    }

    // Всё остальное закрыто.
  }
}
